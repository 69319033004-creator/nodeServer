<section class="py-5 bg-light">
	<div class="container py-3">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				<li class="breadcrumb-item"><a href="/">หน้าแรก</a></li>
				<li class="breadcrumb-item active" aria-current="page">สินค้าทั้งหมด</li>
			</ol>
		</nav>
		<div class="section-kicker mb-2">SHOP ALL PRODUCTS</div>
		<h1 class="section-title mb-2">เลือกอุปกรณ์ที่ใช่สำหรับคุณ</h1>
		<p class="text-muted-custom mb-4">เลือกดูสินค้าขายดีของเรา หรือติดต่อทีมงานเพื่อขอคำแนะนำเพิ่มเติม</p>
		<div class="d-flex flex-wrap gap-2 mb-4" aria-label="หมวดหมู่สินค้า">
			<a class="btn btn-outline-primary rounded-pill" href="#graphics">การ์ดจอ &amp; ซีพียู</a>
			<a class="btn btn-outline-primary rounded-pill" href="#keyboard">คีย์บอร์ด &amp; เมาส์</a>
			<a class="btn btn-outline-primary rounded-pill" href="#monitor">จอภาพ</a>
			<a class="btn btn-outline-primary rounded-pill" href="#mouse">อุปกรณ์เสริม</a>
		</div>
		<div class="row g-4">
			<% products.forEach((product) => { %>
				<div class="col-sm-6 col-lg-3" id="<%= product.id %>">
					<article class="card product-card">
						<div class="product-photo">
							<img src="<%= product.image %>" alt="<%= product.imageAlt %>" loading="lazy">
						</div>
						<div class="card-body">
							<span class="badge badge-soft mb-2"><%= product.badge %></span>
							<p class="small text-muted mb-1"><%= product.category %></p>
							<h2 class="h6"><%= product.name %></h2>
							<p class="small text-muted-custom"><%= product.description %></p>
							<div class="stars mb-3" aria-label="คะแนน 5 จาก 5">★★★★★ <span class="text-muted">(<%= product.rating %>)</span></div>
							<div class="d-flex justify-content-between align-items-center gap-2">
								<span class="price"><%= product.price %></span>
								<a class="btn btn-sm btn-outline-primary rounded-pill" href="tel:025550199" aria-label="สอบถาม<%= product.name %>">สอบถาม</a>
							</div>
						</div>
					</article>
				</div>
			<% }); %>
		</div>
	</div>
</section>